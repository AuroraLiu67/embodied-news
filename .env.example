# Runtime mode: local, test, or production
APP_ENV=local

# Provider mode: mock for credential-free development, live for real integrations
PROVIDER_MODE=mock

# Business time zone
APP_TIME_ZONE=Asia/Shanghai

# Public GitHub Pages repository path; leave empty for root hosting
NEXT_PUBLIC_SITE_BASE_PATH=

# Required only when PROVIDER_MODE=live
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
# Personal recipient only; group chat IDs are intentionally unsupported
FEISHU_NOTIFICATION_RECIPIENT_OPEN_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_REQUEST_LIMIT=100
OPENAI_MAX_INPUT_CHARACTERS=20000
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=60000
